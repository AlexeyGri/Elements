        <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" text="Next" name="NextBtn" class="button" style="width: 25%; height: 100px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; margin-top: 150px; margin-right: 20px; background-color: rgb(49, 77, 121); flex-shrink: 1; font-size: 30%;" />
