<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/Prefabs/UI/InterfaceStyles.uss?fileID=7433441132597879392&amp;guid=ffe5ada1cca4e2a4990e93f9a8639ab3&amp;type=3#InterfaceStyles" />
    <ui:VisualElement name="Root" style="flex-grow: 1; width: 100%; height: 100%; flex-direction: row; justify-content: space-between;">
        <ui:Button text="Reset" parse-escape-sequences="true" display-tooltip-when-elided="true" name="RestartBtn" focusable="true" class="button button-base" style="font-size: 50%; right: 500px; background-color: rgb(225, 30, 71); transition-duration: 1s; transition-timing-function: ease-in-out-back;" />
        <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" text="Next" name="NextBtn" class="button button-base" style="font-size: 50%; transition-timing-function: ease-in-out-back; color: rgb(0, 0, 0); background-color: rgb(126, 174, 246); margin-right: 30px; transition-duration: 1s; left: 500px;" />
    </ui:VisualElement>
</ui:UXML>
