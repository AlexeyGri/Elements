.button-base {
    font-size: 50%;
    width: 25%;
    height: 100px;
    margin-top: 150px;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 30px;
    border-top-right-radius: 30px;
    border-bottom-right-radius: 30px;
    border-bottom-left-radius: 30px;
}

.button-right--show {
    width: 25%;
    height: 100px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    margin-top: 150px;
    margin-right: 30px;
    background-color: rgb(126, 174, 246);
    flex-shrink: 1;
    font-size: 50%;
    translate: -500px 0;
    transition-timing-function: ease-in-bounce;
    transition-duration: 0.5s;
}

.button-left--show {
    font-size: 50%;
    margin-left: 30px;
    translate: 500px 0;
    transition-timing-function: ease-in-bounce;
    transition-duration: 0.5s;
}

.button-base:active {
    scale: 0.9 1;
}
