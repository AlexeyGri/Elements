.button {
    width: 25%;
    height: 100px;
    border-top-left-radius: 40px;
    border-top-right-radius: 40px;
    border-bottom-right-radius: 40px;
    border-bottom-left-radius: 40px;
    font-size: 30%;
    background-color: rgb(203, 29, 66);
}

.button:active {
    scale: 0.9 0.9;
    transition-duration: 0s;
    transition-timing-function: ease;
}
